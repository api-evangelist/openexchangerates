          "name": "Get account plan and usage statistics",
          "request": {
            "name": "Get account plan and usage statistics",
            "description": {
              "content": "Returns basic plan information and usage statistics for the given App ID - account status, plan name, quota, update frequency, enabled features, requests made this month, requests remaining, days elapsed and remaining, and daily average. Requests to this endpoint do not count against your usage volume.",
              "type": "text/plain"
            },
            "url": {
