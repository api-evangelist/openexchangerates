  "item": [
    {
      "id": "55289f8b-5c66-4db7-a798-9dee551362fc",
      "name": "OHLC",
      "description": {
        "content": "Open, high, low, close, and average rates for a period.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6d357739-b6bd-42e1-b31f-3dbe13b3cf1c",
          "name": "Get OHLC rates for a period",
          "request": {
            "name": "Get OHLC rates for a period",
            "description": {
              "content": "Returns open, high, low, close, and time-weighted average exchange rates for a given period. Data is available from December 19th, 2016. The start time must be an ISO-8601 UTC timestamp with zero seconds, aligned to the requested period, and the resulting end time cannot be in the future. Available to clients of the VIP Platinum tier.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ohlc.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<dateTime>",
                  "description": "(Required) ISO-8601 UTC timestamp marking the start of the requested period, for example 2017-07-17T08:30:00Z. Seconds must be zero."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "(Required) The requested period interval."
                },
                {
                  "disabled": false,
                  "key": "base",
                  "value": "USD",
                  "description": "Change the base currency to which all rates are relative, as a 3-letter currency code. Defaults to USD. Changing the base currency requires a paid plan."
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Limit results to specific currencies as a comma-separated list of 3-letter currency codes."
                },
                {
                  "disabled": false,
                  "key": "prettyprint",
                  "value": "false",
                  "description": "Set to true for human-readable response formatting."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
