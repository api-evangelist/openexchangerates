      "id": "b903fcf7-600b-4d5f-80d9-6638e80f3b22",
      "name": "Historical Rates",
      "description": {
        "content": "End-of-day rates for any date back to 1999-01-01.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "46ffe3a7-ebcd-4315-81e1-e6321996828c",
          "name": "Get historical exchange rates for a date",
          "request": {
            "name": "Get historical exchange rates for a date",
            "description": {
              "content": "Returns the end-of-day exchange rates for a given UTC date, currently going back to January 1st, 1999. Rates are the final published values for the day through 23:59:59 UTC; requesting the current UTC date returns the most recent rates (matching latest.json). Base currency and symbols filtering are available on the Developer, Enterprise, and Unlimited plans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "historical",
                "{{date}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "base",
                  "value": "USD",
                  "description": "Change the base currency to which all rates are relative, as a 3-letter currency code. Defaults to USD. Changing the base currency requires a paid plan."
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Limit results to specific currencies as a comma-separated list of 3-letter currency codes."
                },
                {
                  "disabled": false,
                  "key": "show_alternative",
                  "value": "false",
                  "description": "Set to true to extend returned values with alternative, black market, and digital currency rates."
                },
                {
                  "disabled": false,
                  "key": "prettyprint",
                  "value": "false",
                  "description": "Set to true for human-readable response formatting."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
