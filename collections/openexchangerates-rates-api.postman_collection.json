          "id": "4c965cc4-d21e-41a5-ba6f-cdbd94617d73",
          "name": "Get latest exchange rates",
          "request": {
            "name": "Get latest exchange rates",
            "description": {
              "content": "Returns the latest available exchange rates for all supported currencies, updated approximately every hour. The base currency defaults to USD.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "latest.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "app_id",
                  "value": "<string>",
                  "description": "(Required) Your unique App ID for authentication"
                },
                {
                  "disabled": false,
                  "key": "base",
                  "value": "<string>",
                  "description": "Change base currency (3-letter ISO code). Defaults to USD. Non-USD base currencies may require a paid plan.\n"
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Limit results to specific currencies. Provide a comma-separated list of 3-letter ISO currency codes.\n"
                },
                {
                  "disabled": false,
                  "key": "prettyprint",
                  "value": "false",
                  "description": "Set to true to enable human-readable (pretty-printed) JSON output for debugging. Defaults to false to minimize response size.\n"
                },
                {
                  "disabled": false,
                  "key": "show_alternative",
                  "value": "false",
                  "description": "Set to true to extend returned values with alternative, black market and digital currency rates. Defaults to false.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
