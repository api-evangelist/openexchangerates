        {
          "id": "d1d0ad92-a68f-4a42-b6f2-84a1cb03f1e9",
          "name": "Get historical exchange rates",
          "request": {
            "name": "Get historical exchange rates",
            "description": {
              "content": "Returns exchange rates for a specific historical date. Data is available back to January 1, 1999. Rates reflect the last published values for the given UTC day (through 23:59:59 UTC).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "historical",
                "{{date}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "app_id",
                  "value": "<string>",
                  "description": "(Required) Your unique App ID for authentication"
                },
                {
                  "disabled": false,
                  "key": "base",
                  "value": "<string>",
                  "description": "Base currency (3-letter ISO code, defaults to USD)"
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Comma-separated 3-letter ISO currency codes to limit results"
                },
                {
                  "disabled": false,
                  "key": "prettyprint",
                  "value": "false",
                  "description": "Set to true to enable human-readable (pretty-printed) JSON output for debugging. Defaults to false to minimize response size.\n"
                },
                {
                  "disabled": false,
                  "key": "show_alternative",
                  "value": "false",
                  "description": "Set to true to extend returned values with alternative, black market and digital currency rates. Defaults to false.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
