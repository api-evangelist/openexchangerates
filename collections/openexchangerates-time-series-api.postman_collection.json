      "name": "Time Series",
      "description": {
        "content": "Bulk daily historical rates for a date range.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e58688d4-63c9-4dc7-ae40-1ad669e26f20",
          "name": "Get bulk daily rates for a date range",
          "request": {
            "name": "Get bulk daily rates for a date range",
            "description": {
              "content": "Returns daily historical exchange rates for a given start and end date (both inclusive). The maximum query period currently allowed is one month, and each day in the range counts as one API request against your quota. Available on the Enterprise and Unlimited plans. Use the symbols parameter to limit results and reduce payload size.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "time-series.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<date>",
                  "description": "(Required) The start date of the requested period (YYYY-MM-DD, inclusive)."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<date>",
                  "description": "(Required) The end date of the requested period (YYYY-MM-DD, inclusive)."
                },
                {
                  "disabled": false,
                  "key": "base",
                  "value": "USD",
                  "description": "Change the base currency to which all rates are relative, as a 3-letter currency code. Defaults to USD. Changing the base currency requires a paid plan."
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Limit results to specific currencies as a comma-separated list of 3-letter currency codes."
                },
                {
                  "disabled": false,
                  "key": "show_alternative",
                  "value": "false",
                  "description": "Set to true to extend returned values with alternative, black market, and digital currency rates."
                },
                {
                  "disabled": false,
                  "key": "prettyprint",
                  "value": "false",
                  "description": "Set to true for human-readable response formatting."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
