          "name": "Get the latest exchange rates",
          "request": {
            "name": "Get the latest exchange rates",
            "description": {
              "content": "Returns the latest exchange rates available from the Open Exchange Rates API, relative to the base currency (USD by default). Rates refresh hourly on the Free and Developer plans, every 30 minutes on Enterprise, and every 5 minutes on Unlimited.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "latest.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "base",
                  "value": "USD",
                  "description": "Change the base currency to which all rates are relative, as a 3-letter currency code. Defaults to USD. Changing the base currency requires a paid plan."
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Limit results to specific currencies as a comma-separated list of 3-letter currency codes."
                },
                {
                  "disabled": false,
                  "key": "show_alternative",
                  "value": "false",
                  "description": "Set to true to extend returned values with alternative, black market, and digital currency rates."
                },
